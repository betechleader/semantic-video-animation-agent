MAX_UPLOAD_MB=100
COMMAND_TIMEOUT_SECONDS=120
TASK_RETENTION_HOURS=168
ASR_PROVIDER=mock
ASR_MODEL=small
ASR_LOCAL_FILES_ONLY=true
KNOWLEDGE_MAX_FILE_MB=5
KNOWLEDGE_CHUNK_CHARS=600
KNOWLEDGE_CHUNK_OVERLAP_CHARS=80
KNOWLEDGE_EMBEDDING_PROVIDER=local_hash
KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-m3
KNOWLEDGE_EMBEDDING_LOCAL_FILES_ONLY=true

# Default keeps the original in-process lightweight runtime. Set worker to
# dispatch durable SQLite jobs to `python -m backend.app.worker`.
EXECUTION_MODE=local
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=30
WORKER_HEARTBEAT_SECONDS=5
WORKER_MAX_ATTEMPTS=3
